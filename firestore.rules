rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('targetBand' in data) || (data.targetBand is number)) &&
             (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 64)) &&
             (!('currentBand' in data) || (data.currentBand is number)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.id == resource.data.id &&
                    request.resource.data.email == resource.data.email &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // --- Mock Attempts Collection ---
    function isValidMockAttempt(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.bookNumber is number && data.testNumber is number &&
             data.module is string && data.module.size() <= 32 &&
             data.bandScore is number &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /mock_attempts/{attemptId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(attemptId) && isValidMockAttempt(request.resource.data);
      allow update: if isSignedIn() && isValidMockAttempt(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Writing Submissions Collection ---
    function isValidWritingSubmission(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.taskType is string && data.taskType.size() <= 32 &&
             data.essayText is string && data.essayText.size() <= 10000 &&
             data.overallBand is number &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /writing_submissions/{submissionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(submissionId) && isValidWritingSubmission(request.resource.data);
      allow update: if isSignedIn() && isValidWritingSubmission(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Speaking Sessions Collection ---
    function isValidSpeakingSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.partNumber is number &&
             data.overallBand is number &&
             (!('transcript' in data) || (data.transcript is string && data.transcript.size() <= 8000)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /speaking_sessions/{sessionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSpeakingSession(request.resource.data);
      allow update: if isSignedIn() && isValidSpeakingSession(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
